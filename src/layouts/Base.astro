---
/**
 * Shared page shell: SEO tags, structured data, nav, footer and scripts.
 * Every page on the site uses this so they all look and behave the same.
 */
import { business, BUILD_VERSION as v, SITE } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;          // path under /public, used for social previews
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  isHome?: boolean;
  noindex?: boolean;
}

const { title, description, image = '/assets/img/og-default.jpg', type = 'website', schema = [], isHome = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const h = isHome ? '' : '/'; // section links point back to the homepage from other pages
const path = Astro.url.pathname;
const jsonLd = [business, ...schema];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta name="theme-color" content="#0b0b0c">

  <meta property="og:site_name" content="In2ition Media">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="en_GY">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <link rel="icon" href="/assets/img/logo-dark.png">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href="/fonts/inter-tight-normal-2.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/instrument-serif-italic-0.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href={`/css/style.css?v=${v}`}>
  {jsonLd.map(item => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  <script is:inline>
    // Flag motion support before first paint so hidden-until-animated states never flash
    (function () {
      var d = document.documentElement;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      // Intro curtain only on larger screens; phones go straight to the content
      try { if (window.matchMedia('(min-width: 861px)').matches && !sessionStorage.getItem('i2m-intro')) d.classList.add('intro'); } catch (e) {}
    })();
  </script>
</head>
<body>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="wa" viewBox="0 0 32 32"><path fill="currentColor" d="M16.04 3C9.08 3 3.43 8.64 3.43 15.6c0 2.22.58 4.4 1.69 6.31L3.33 28.5l6.76-1.77a12.56 12.56 0 0 0 5.95 1.51h.01c6.96 0 12.61-5.65 12.61-12.61C28.66 8.64 23 3 16.04 3zm0 23.1h-.01a10.45 10.45 0 0 1-5.33-1.46l-.38-.23-4.01 1.05 1.07-3.91-.25-.4a10.45 10.45 0 0 1-1.6-5.55c0-5.78 4.7-10.48 10.5-10.48 2.8 0 5.44 1.09 7.42 3.07a10.42 10.42 0 0 1 3.07 7.42c0 5.79-4.7 10.49-10.48 10.49zm5.75-7.85c-.31-.16-1.86-.92-2.15-1.02-.29-.11-.5-.16-.71.16-.21.31-.81 1.02-1 1.23-.18.21-.37.24-.68.08-.31-.16-1.33-.49-2.53-1.56-.94-.83-1.57-1.86-1.75-2.18-.18-.31-.02-.48.14-.64.14-.14.31-.37.47-.55.16-.18.21-.31.31-.52.1-.21.05-.39-.03-.55-.08-.16-.71-1.71-.97-2.34-.26-.62-.52-.53-.71-.54h-.6c-.21 0-.55.08-.84.39-.29.31-1.1 1.08-1.1 2.63s1.13 3.05 1.28 3.26c.16.21 2.22 3.38 5.37 4.74.75.32 1.34.52 1.8.66.75.24 1.44.21 1.98.13.6-.09 1.86-.76 2.12-1.5.26-.73.26-1.37.18-1.5-.08-.13-.29-.21-.6-.37z"/></symbol></svg>
  <a class="skip" href="#main">Skip to content</a>

  {isHome && (
    <div class="loader" aria-hidden="true">
      <div class="loader__inner">
        <img src="/assets/img/logo-white-360.png" alt="" class="loader__logo" width="360" height="215">
        <div class="loader__bar"><span></span></div>
      </div>
    </div>
  )}

  <div class="progress" aria-hidden="true"><span></span></div>
  <div class="cursor" aria-hidden="true"><span class="cursor__label">View</span></div>

  <header class="nav" id="nav">
    <div class="nav__shell">
      <a href={isHome ? '#top' : '/'} class="nav__logo" aria-label="In2ition Media home">
        <img src="/assets/img/logo-white-180.png" alt="In2ition Media" class="logo-on-dark" width="180" height="108">
        <img src="/assets/img/logo-dark-180.png" alt="" class="logo-on-light" aria-hidden="true" width="180" height="108" loading="lazy">
      </a>
      <nav class="nav__links" aria-label="Main">
        <a href={`${h}#work`} class="roll"><span data-text="Work">Work</span></a>
        <a href={`${h}#reviews`} class="roll"><span data-text="Reviews">Reviews</span></a>
        <a href={`${h}#services`} class="roll"><span data-text="Services">Services</span></a>
        <a href={`${h}#process`} class="roll"><span data-text="Process">Process</span></a>
        <a href={`${h}#about`} class="roll"><span data-text="About">About</span></a>
        <a href="/blog/" class:list={['roll', { 'is-current': path.startsWith('/blog') }]} aria-current={path.startsWith('/blog') ? 'page' : undefined}><span data-text="Blog">Blog</span></a>
      </nav>
      <a href={`${h}#contact`} class="btn btn--red btn--sm nav__cta" data-magnetic><span class="btn__label" data-text="Start a project">Start a project</span></a>
      <button class="nav__toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu"><span></span><span></span></button>
    </div>
  </header>

  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <nav aria-label="Mobile">
      <a href={`${h}#work`}><small>01</small>Work</a>
      <a href={`${h}#reviews`}><small>02</small>Reviews</a>
      <a href={`${h}#services`}><small>03</small>Services</a>
      <a href={`${h}#process`}><small>04</small>Process</a>
      <a href={`${h}#about`}><small>05</small>About</a>
      <a href="/blog/"><small>06</small>Blog</a>
    </nav>
    <a href={`${h}#contact`} class="btn btn--red">Start a project <span aria-hidden="true">→</span></a>
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="footer section--dark">
    <div class="container">
      <p class="eyebrow">Have a project in mind?</p>
      <a href={`${h}#contact`} class="footer__cta" data-magnetic>
        <span class="footer__cta-text">Let's <em>talk</em></span>
        <span class="footer__cta-arrow" aria-hidden="true">→</span>
      </a>
      <div class="footer__links">
        <div>
          <p class="footer__heading">Case studies</p>
          <a href="/work/arctic-zone-hvac/">Arctic Zone HVAC</a>
          <a href="/work/specom/">Specom</a>
          <a href="/work/singing-chef-adventures/">Singing Chef Adventures</a>
        </div>
        <div>
          <p class="footer__heading">Studio</p>
          <a href={`${h}#services`}>Services</a>
          <a href={`${h}#reviews`}>Reviews</a>
          <a href="/blog/">Blog</a>
        </div>
        <div>
          <p class="footer__heading">Visit</p>
          <address>69 Nandy Park<br>East Bank Demerara, Guyana</address>
          <a href="tel:+5926922647">+592 692 2647</a>
        </div>
      </div>
      <div class="footer__bottom">
        <img src="/assets/img/logo-white-180.png" alt="In2ition Media" class="footer__logo" width="180" height="108" loading="lazy">
        <nav aria-label="Social">
          <a href="https://www.facebook.com/in2itionmedia/" target="_blank" rel="noopener" class="roll"><span data-text="Facebook">Facebook</span></a>
          <a href="https://www.instagram.com/in2ition.media" target="_blank" rel="noopener" class="roll"><span data-text="Instagram">Instagram</span></a>
          <a href="https://maps.google.com/?cid=3596183034083991518" target="_blank" rel="noopener" class="roll"><span data-text="Google">Google</span></a>
        </nav>
        <p>© <span id="year">2026</span> In2ition Media · East Bank Demerara, Guyana</p>
      </div>
    </div>
  </footer>

  <a class="wa-float" href="https://wa.me/5926922647?text=Hi%20In2ition%20Media%2C%20I%27d%20like%20to%20talk%20about%20a%20website." target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp, +592 692 2647">
    <svg viewBox="0 0 32 32" aria-hidden="true"><use href="#wa"/></svg>
    <span class="wa-float__label">Chat on WhatsApp</span>
  </a>

  <script is:inline defer src="/vendor/gsap.min.js"></script>
  <script is:inline defer src="/vendor/ScrollTrigger.min.js"></script>
  <script is:inline defer src="/vendor/lenis.min.js"></script>
  <script is:inline defer src={`/js/main.js?v=${v}`}></script>
</body>
</html>
